{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mcp-cloud-deploy-server",
  "main": "index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000", "preview_id": "00000000000000000000000000000001" }
  ]
}
