{
  "name": "mcp-cloud-deploy",
  "version": "1.0.0",
  "description": "A local-first MCP server for deploying static sites and SPAs to Cloudflare Pages.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "mcp-cloud-deploy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/set-bin-permissions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "node dist/index.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "blake3-wasm": "^2.1.5",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.3",
    "mime-types": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.160.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudflare-pages",
    "deployment",
    "typescript",
    "developer-tools"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PRIVACY.md",
    ".env.example",
    "claude_desktop_config.json",
    "examples/README.md",
    "examples/configs/",
    "scripts/start-local.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoangtrietdev/cloudflare-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/hoangtrietdev/cloudflare-mcp/issues"
  },
  "homepage": "https://github.com/hoangtrietdev/cloudflare-mcp#readme"
}
